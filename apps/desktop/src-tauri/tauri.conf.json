{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenClaw Toolkit",
  "version": "0.1.0",
  "identifier": "com.openclaw.toolkit",
  "build": {
    "beforeDevCommand": "pnpm vite --host 127.0.0.1 --port 31420",
    "devUrl": "http://127.0.0.1:31420",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenClaw Toolkit",
        "width": 1200,
        "height": 760,
        "resizable": true,
        "maximizable": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../../artifacts": "artifacts",
      "../../../licenses": "licenses"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": null,
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
