{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenClaw Toolkit",
  "version": "0.1.5",
  "identifier": "com.openclaw.toolkit",
  "build": {
    "beforeDevCommand": "pnpm vite --host 127.0.0.1 --port 31420",
    "devUrl": "http://127.0.0.1:31420",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenClaw Toolkit",
        "width": 1200,
        "height": 760,
        "resizable": true,
        "maximizable": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../../artifacts": "artifacts"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": null,
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2NTk1MzIwREZBQjhBOQpSV1NwdVBvTk1wVmxDcW9tRWlsYy85b0o5eExlaStxOUpCekNpc0J4NkVNZkFZNFp5UW8wYmhmUwo=",
      "endpoints": [
        "https://github.com/wsz987/openclaw-toolkit/releases/latest/download/latest.json",
        "https://github.com/wsz987/openclaw-toolkit/releases/latest/download/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
