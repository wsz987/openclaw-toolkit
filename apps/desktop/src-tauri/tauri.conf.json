{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenClaw Toolkit",
  "version": "0.1.0",
  "identifier": "com.openclaw.toolkit",
  "build": {
    "beforeDevCommand": "pnpm vite --host 127.0.0.1 --port 31420",
    "devUrl": "http://127.0.0.1:31420",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenClaw Toolkit",
        "width": 1200,
        "height": 760,
        "resizable": true,
        "maximizable": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../../artifacts": "artifacts",
      "../../../licenses/license.dat": "licenses/license.dat"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": null,
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczODhCRTgzNkQwMjAwRjMKUldUekFBSnRnNzZJYzlpbEl5UVZ6WUw1WTU1blp6U0N3RFpSM1dqUkc3RlhBQmx3QUlTMFpVYTcK",
      "endpoints": [
        "https://openclaw.wsz987.xyz/api/v1/desktop/updates/{{target}}/{{arch}}/{{current_version}}",
        "http://47.80.6.78/api/v1/desktop/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
