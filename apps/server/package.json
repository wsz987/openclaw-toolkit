{
  "name": "@openclaw-toolkit/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 31421",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 31421",
    "start:docker": "node scripts/start-docker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:prepare": "node -e \"require('node:fs').mkdirSync('data', { recursive: true })\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "pnpm db:prepare && drizzle-kit push"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.44.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "semver": "^7.7.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/semver": "^7.7.0",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
