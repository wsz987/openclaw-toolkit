# 复制本文件为 .env 并填入实际值（.env 已被 gitignore，不会提交）。
# .env 与 docker-compose.yml 同目录时，docker compose 会自动读取。

# 管理后台 / 管理接口的访问令牌（Bearer Token）。
# 必填：compose 的 ${SERVER_ADMIN_TOKEN:?} 强制要求，未设置会拒绝启动。
# 生成随机值：openssl rand -hex 32
SERVER_ADMIN_TOKEN=

# 对外公开的更新服务地址（可选，默认占位地址不会暴露私有基础设施）
# PUBLIC_SERVER_BASE_URL=https://YOUR-UPDATE-SERVER.invalid

# 更新通道（可选，默认 stable）
# OPENCLAW_UPDATE_CHANNEL=stable
