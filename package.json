{
  "name": "openclaw-toolkit",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --filter @openclaw-toolkit/desktop build",
    "dev:desktop": "pnpm --filter @openclaw-toolkit/desktop dev",
    "dev:server": "pnpm --filter @openclaw-toolkit/server dev",
    "test:server": "pnpm --filter @openclaw-toolkit/server test",
    "typecheck": "pnpm --filter @openclaw-toolkit/desktop typecheck",
    "plugin:uninstall": "node scripts/uninstall-openclaw-plugin.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  },
  "workspaces": [
    "apps/desktop",
    "apps/server"
  ]
}
